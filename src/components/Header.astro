---
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <a class="brand" href="/" aria-label="Rohan Mishra home">
    <img src="/assets/logo.svg" alt="Rohan Mishra" width="64" height="40" />
  </a>
  <nav aria-label="Main navigation">
    <ul>
      <li><a href="/work/">Work</a></li>
      <li><a href="/about/">About</a></li>
      <li><a href="/#contact">Hire me</a></li>
    </ul>
  </nav>
</header>
